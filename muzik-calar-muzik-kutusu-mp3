            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-placeholder {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #4f46e5, #06b6d4);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 20px;
        }}

        .brand h1 {
            font-size: 24px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .lang-selector select {
            padding: 10px 16px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background-color: var(--card-bg);
            color: var(--text-primary);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            outline: none;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
            transition: all 0.2s;
        }

        .lang-selector select:focus {
            border-color: var(--accent-color);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 40px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        }

        .policy-title {
            font-size: 28px;
            font-weight: 800;
            color: var(--text-primary);
            margin-bottom: 24px;
            line-height: 1.3;
        }

        .policy-content {
            font-size: 16px;
            color: var(--text-primary);
            white-space: pre-line;
            text-align: justify;
        }

        footer {
            text-align: center;
            margin-top: 40px;
            font-size: 14px;
            color: var(--text-secondary);
        }

        /* RTL Styles */
        .rtl {
            direction: rtl;
            text-align: right;
        }
        .rtl .policy-content {
            text-align: right;
        }

